#!/usr/bin/env python3
"""validate — every ID resolves, times are in bounds, echoes haven't drifted.

Per specs/06-skill.md: run before trusting any skill output or hand-edited
narrative/cut. Three checks:
  1. existence — every seg_/clip_ ID resolves in the DB. A re-transcribed
     clip's old-generation segment IDs fail here BY DESIGN (the r<gen> token);
     repair is a skill operation, never a silent re-bind.
  2. bounds — segment t_in/t_out fall inside its clip's duration.
  3. echo drift — the human-readable echo beside an ID still matches the
     transcript text (fuzzy). Drift is a WARNING (exit 0): the transcript is
     authority, the echo is a courtesy copy.

Inputs: --cut CUT.json (array of ids, {"segments": [...]}, or array of
{"id":..., "echo":...}) and/or --narrative FILE.md (every seg_/clip_ token in
the file is checked; a trailing <!-- echo --> on the same line is compared).

Exit 1 on missing IDs or bad bounds; drift alone exits 0.

Usage: scripts/validate [--cut CUT.json] [--narrative FILE.md]
                        [--config PATH] [--db PATH]
"""

import argparse
import difflib
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from common import die, load_config, open_db, require_drive

ID_RE = re.compile(r"\b(?:seg|clip|kf)_[A-Za-z0-9]+(?:_r\d+_\d+|_\d+)?\b")
ECHO_RE = re.compile(r"<!--\s*(.*?)\s*-->")
DRIFT_THRESHOLD = 0.6
BOUNDS_SLACK_S = 0.5


def norm(text: str) -> str:
    return re.sub(r"\s+", " ", text.strip().lower())


def gather_refs(args) -> list[tuple[str, str | None]]:
    """(id, echo_or_None) from the cut file and/or narrative markdown."""
    refs = []
    if args.cut:
        raw = sys.stdin.read() if args.cut == "-" else Path(args.cut).read_text()
        data = json.loads(raw)
        items = data["segments"] if isinstance(data, dict) else data
        for item in items:
            if isinstance(item, dict):
                refs.append((item["id"], item.get("echo")))
            else:
                refs.append((item, None))
    if args.narrative:
        for line in Path(args.narrative).read_text().splitlines():
            ids = ID_RE.findall(line)
            echo_m = ECHO_RE.search(line)
            echo = echo_m.group(1) if echo_m and len(ids) == 1 else None
            refs += [(i, echo) for i in ids]
    return refs


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--cut", help="cut JSON file, or - for stdin")
    ap.add_argument("--narrative", help="narrative/markdown file to scan")
    ap.add_argument("--config")
    ap.add_argument("--db")
    ap.add_argument("--json", action="store_true",
                    help="accepted for CLI consistency; output is always JSON")
    args = ap.parse_args()
    if not args.cut and not args.narrative:
        die("nothing to validate: pass --cut and/or --narrative")

    cfg = load_config(args.config)
    require_drive(cfg)
    conn = open_db(cfg, args.db)

    refs = gather_refs(args)
    report = {"checked": len(refs), "missing": [], "bounds": [], "drift": []}
    for rid, echo in refs:
        table = {"seg": "segment", "clip": "clip", "kf": "keyframe"}[rid.split("_")[0]]
        if table == "segment":
            row = conn.execute(
                "SELECT s.t_in, s.t_out, s.text, c.duration_s FROM segment s "
                "JOIN clip c ON c.id = s.clip_id WHERE s.id = ?", (rid,)).fetchone()
        else:
            row = conn.execute(
                f"SELECT 1 FROM {table} WHERE id = ?", (rid,)).fetchone()
        if row is None:
            report["missing"].append(rid)
            continue
        if table == "segment":
            if not (0 <= row["t_in"] < row["t_out"]
                    <= row["duration_s"] + BOUNDS_SLACK_S):
                report["bounds"].append(
                    {"id": rid, "t_in": row["t_in"], "t_out": row["t_out"],
                     "clip_duration_s": row["duration_s"]})
            if echo:
                ratio = difflib.SequenceMatcher(
                    None, norm(echo), norm(row["text"])).ratio()
                if ratio < DRIFT_THRESHOLD:
                    report["drift"].append(
                        {"id": rid, "echo": echo, "text": row["text"],
                         "similarity": round(ratio, 3)})

    report["ok"] = not report["missing"] and not report["bounds"]
    print(json.dumps(report, indent=2, ensure_ascii=False))
    sys.exit(0 if report["ok"] else 1)


if __name__ == "__main__":
    main()
