    <library>
        <event name="spike-cut (Resolve)">
            <project name="spike-cut (Resolve)">
                <sequence tcStart="0/1s" format="r0" tcFormat="NDF" duration="20/1s">
                    <spine>
                        <asset-clip enabled="1" start="5/1s" offset="0/1s" format="r0" tcFormat="NDF" duration="10/1s" ref="r1" name="clip-a.mov">
