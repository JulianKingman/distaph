        <format height="1920" width="1080" id="r2" frameDuration="1/30s" name="FFVideoFormatRateUndefined"/>
        <asset audioChannels="1" hasVideo="1" start="0/1s" hasAudio="1" format="r0" id="r1" duration="505/24s" name="clip-a.mov" audioSources="1">
            <media-rep kind="original-media" src="file:///Volumes/ARCHIVE/footage/clip-a.mov"/>
        </asset>
        <asset audioChannels="2" hasVideo="1" start="0/1s" hasAudio="1" format="r2" id="r3" duration="3373/10s" name="clip-b.mov" audioSources="1">
            <media-rep kind="original-media" src="file:///Volumes/ARCHIVE/footage/clip-b.mov"/>
