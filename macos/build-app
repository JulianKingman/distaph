#!/bin/bash
# Build Distaph.app with Xcode and put `distaph` on your PATH. Run it once
# after cloning, and again after pulling changes to macos/:
#
#   /Applications/Distaph/macos/build-app
#
# Same result as opening macos/Distaph/Distaph.xcodeproj in Xcode and pressing
# Run: the build copies Distaph.app to the root of this folder, next to bin/.
# The app holds no code or data, so it's safe to rebuild any time.
#
# Open Distaph with Option held to choose a different library.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

if ! xcodebuild -version >/dev/null 2>&1; then
  echo "Building Distaph.app needs Xcode (the full app, not just the command line tools)."
  echo "Install it from the App Store, open it once, then run this again."
  exit 1
fi
command -v uv >/dev/null || {
  echo "Note: Distaph needs uv to run. Install it with:"
  echo "  curl -LsSf https://astral.sh/uv/install.sh | sh"
}

xcodebuild -quiet \
  -project "$ROOT/macos/Distaph/Distaph.xcodeproj" \
  -target Distaph -configuration Release \
  SYMROOT="$WORK/build" OBJROOT="$WORK/obj" build

echo "Built $ROOT/Distaph.app"

for dir in /opt/homebrew/bin "$HOME/.local/bin"; do
  if [ -d "$dir" ] && [ -w "$dir" ]; then
    ln -sf "$ROOT/bin/distaph" "$dir/distaph"
    echo "Linked $dir/distaph"
    break
  fi
done
